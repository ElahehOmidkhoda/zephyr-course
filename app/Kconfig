

menuconfig LED_SUBSYSTEM    
    bool "LED Subsystem"
    default y
    help
      Enable the LED subsystem. This subsystem provides a common API for
      controlling LEDs on different boards and platforms. It allows for
      easy integration of LED drivers and provides a unified interface for
      applications to control LEDs.
if LED_SUBSYSTEM
choice 
    prompt "LED blink sleep time"
    default BLINK_SLEEP_TIME_1000MS

config BLINK_SLEEP_TIME_250MS
    bool "250ms (very fast)"
    help
        Set the sleep time for the blink application to 250 milliseconds.
config BLINK_SLEEP_TIME_500MS
    bool "500ms (fast)"
    help
        Set the sleep time for the blink application to 500 milliseconds.
config BLINK_SLEEP_TIME_1000MS
    bool "1s (medium)"
    help
        Set the sleep time for the blink application to 1000 milliseconds.
config BLINK_SLEEP_TIME_2000MS
    bool "2s (slow)"  
    help
        Set the sleep time for the blink application to 2000 milliseconds.
endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_SLEEP_TIME_250MS
    default 500 if BLINK_SLEEP_TIME_500MS
    default 1000 if BLINK_SLEEP_TIME_1000MS
    default 2000 if BLINK_SLEEP_TIME_2000MS
    default 0
    help
        Set the sleep time for the blink application in milliseconds.

menuconfig ADVANCED_LED_SETTINGS
    bool "Advanced LED settings"
    default n

if ADVANCED_LED_SETTINGS
config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    range 0 5000
    default 500

menu "Expert settings"
    visible if ADVANCED_LED_SETTINGS
config ENABLE_LED_DEBUGGING
    bool "Enable LED debugging"
    default n

config CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n
endmenu
endif
endif
    

source "Kconfig.zephyr"